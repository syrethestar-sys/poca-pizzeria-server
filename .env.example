MONGO_URI=mongodb+srv://<user>:<password>@poca.xxxxx.mongodb.net/poca?retryWrites=true&w=majority
PORT=1000

# Clerk verifies the session on every protected route. Both come from the
# frontend's .env.local, written there by `clerk init` — copy the secret across
# and rename NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY to CLERK_PUBLISHABLE_KEY.
# Without the secret the API boots but rejects every Clerk session.
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...

# Grants the admin role to an account that already exists. Clerk owns sign-up,
# so the person signs up through the app first and `npm run seed` promotes
# them — there is no password to set here.
SEED_ADMIN_EMAIL=admin@poca.mn

# The deployed frontend, e.g. https://pocapizzeria.mn — used for Wire's
# post-payment return_url. No trailing slash.
FRONTEND_URL=http://localhost:3000

# Wire (wire.mn) payment gateway — sk_test_/sk_live_ from the API key page,
# whsec_... from the Webhook page (shown once, when the endpoint is created).
WIRE_API_KEY=
WIRE_WEBHOOK_SECRET=
# Optional: limit checkout to these operator ids, comma-separated. Empty =
# every operator activated on the Wire account.
WIRE_OPERATORS=

# Cloudinary (Settings → API Keys). Admin image uploads are signed by the API
# with the secret, so no unsigned preset is needed — delete that preset.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
