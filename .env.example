MONGO_URI=mongodb+srv://<user>:<password>@poca.xxxxx.mongodb.net/poca?retryWrites=true&w=majority
PORT=1000
JWT_SECRET=change-me-to-a-long-random-string

# Used once by `npm run seed` to create the first admin login.
SEED_ADMIN_EMAIL=admin@poca.mn
SEED_ADMIN_PASSWORD=change-me

# The deployed frontend, e.g. https://pocapizzeria.mn — used to build links
# in emails and Wire's post-payment return_url. No trailing slash.
FRONTEND_URL=http://localhost:3000

# SMTP for password-reset emails. Left blank, reset links are logged to the
# console instead of sent — fine for local dev, not for production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Wire (wire.mn) payment gateway — sk_test_/sk_live_ from the API key page,
# whsec_... from the Webhook page (shown once, when the endpoint is created).
WIRE_API_KEY=
WIRE_WEBHOOK_SECRET=
